{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动服务",
      "type": "shell",
      "command": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\"",
      "args": ["main.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "启动服务（Trae 预览）",
      "type": "shell",
      "command": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\"",
      "args": ["main.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "APP_HEADLESS": "1",
          "APP_PORT": "8080",
          "PYTHONIOENCODING": "utf-8",
          "PYTHONUTF8": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nicegui-preview",
        "pattern": { "regexp": "^\\s*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "云枢后台管理",
          "endsPattern": "本机访问: http://127\\.0\\.0\\.1:\\d+"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "启动服务并打开预览",
      "dependsOn": ["启动服务（Trae 预览）"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "运行测试",
      "type": "shell",
      "command": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\"",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "打包 exe",
      "type": "shell",
      "command": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\"",
      "args": [
        "-m", "PyInstaller", "--noconfirm", "--clean", "--onedir", "--windowed",
        "--name", "云枢后台管理",
        "--collect-all", "nicegui",
        "--collect-submodules", "uvicorn",
        "--hidden-import", "sqlalchemy.dialects.sqlite",
        "main.py"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
